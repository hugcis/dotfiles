# .packages.arch — declarative Arch Linux package list
# Usage: sudo pacman -S --needed - < ~/.packages.arch
#
# Only tools home-manager does not provide belong here; HM-managed twins
# (git, fzf, ripgrep, tmux, bat, starship, gh, nerd fonts) are installed
# by the nix profile, which also wins PATH priority
# (see ~/.config/home-manager).

# Login shell (system-level, not HM-managed)
zsh

# Build tools
cmake

# Spelling
aspell

# SSH & Clipboard
keychain
xclip
xsel
