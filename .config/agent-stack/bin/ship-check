#!/usr/bin/env python3
"""Local pre-flight for ship checks. Nothing trusts this output."""
from __future__ import annotations

import argparse
import json
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))
from ship_check_core import VERSION, deterministic_checks, failed_checks, resolve_base, status  # noqa: E402

NOOP_TEST_COMMANDS = {"true", "/usr/bin/true", "/bin/true", ":"}


def parse_ship_check_toml(path: Path) -> str | None:
    if not path.exists():
        return None
    try:
        import tomllib
    except ModuleNotFoundError:
        tomllib = None
    if tomllib is not None:
        data = tomllib.loads(path.read_text())
        value = data.get("test-cmd") or data.get("test_cmd")
        return value if isinstance(value, str) else None
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, value = [part.strip() for part in line.split("=", 1)]
        if key in {"test-cmd", "test_cmd"}:
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                return value[1:-1]
            return value
    return None


def test_command(args: argparse.Namespace) -> str | None:
    if args.test_cmd:
        return args.test_cmd
    return parse_ship_check_toml(Path("ship-check.toml"))


def is_noop_command(command: str) -> bool:
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    if not words:
        return True
    return len(words) == 1 and words[0] in NOOP_TEST_COMMANDS


def check_tests(args: argparse.Namespace) -> dict:
    command = test_command(args)
    if not command:
        return status("tests", "skipped", "no test command configured; pass --test-cmd or add ship-check.toml", command=None)
    if is_noop_command(command):
        return status("tests", "fail", f"test command {command!r} is a no-op bypass", command=command, exit_code=None)
    proc = subprocess.run(command, shell=True, text=True, capture_output=True)
    if proc.returncode != 0:
        return status(
            "tests",
            "fail",
            f"test command exited with exit code {proc.returncode}: {command}",
            command=command,
            exit_code=proc.returncode,
            stdout_tail="\n".join(proc.stdout.splitlines()[-40:]),
            stderr_tail="\n".join(proc.stderr.splitlines()[-40:]),
        )
    return status("tests", "pass", f"test command passed: {command}", command=command, exit_code=0)


def check_mutation(args: argparse.Namespace, base: str) -> dict:
    if not args.mutate:
        return status("mutation", "skipped", "--mutate not requested")
    script = Path(__file__).resolve().parents[1] / "local-skills" / "rebuilding-final-tests" / "scripts" / "mutation_compare.py"
    with tempfile.TemporaryDirectory(prefix="ship-check-mutate-") as tmp:
        out = Path(tmp) / "baseline.json"
        proc = subprocess.run([sys.executable, str(script), "baseline", "--base", base, "--out", str(out)], text=True, capture_output=True)
        payload = json.loads(out.read_text()) if out.exists() else None
    if proc.returncode != 0:
        return status(
            "mutation",
            "fail",
            f"mutation_compare exited {proc.returncode}",
            exit_code=proc.returncode,
            stdout_tail="\n".join(proc.stdout.splitlines()[-40:]),
            stderr_tail="\n".join(proc.stderr.splitlines()[-40:]),
            report=payload,
        )
    return status("mutation", "pass", "mutation_compare passed", exit_code=0, report=payload)


def print_check(result: dict) -> None:
    print(f"{result['name']}: {result['status'].upper()} - {result['summary']}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--test-cmd")
    parser.add_argument("--mutate", action="store_true")
    args = parser.parse_args(argv)
    repo = Path.cwd()
    try:
        base = resolve_base(repo, args.base)
        checks = [*deterministic_checks(repo, base), check_tests(args), check_mutation(args, base)]
    except (subprocess.CalledProcessError, OSError, json.JSONDecodeError) as error:
        print(f"ship-check: {error}", file=sys.stderr)
        return 2
    for result in checks:
        print_check(result)
    return 1 if failed_checks(checks) else 0


if __name__ == "__main__":
    raise SystemExit(main())
