#!/usr/bin/env python3
"""Pre-push ship gate: verify HEAD against a base ref and write a receipt."""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath

VERSION = "ship-check-0.1"
PRODUCTION_LIMIT = 600
WORKING_DOC_PATTERNS = (
    "docs/plans/*",
    "docs/plans/**",
    "docs/superpowers/*",
    "docs/superpowers/**",
    ".superpowers/*",
    ".superpowers/**",
    "*-plan.md",
    "**/*-plan.md",
    "*-design.md",
    "**/*-design.md",
    "*test-audit*.md",
    "**/*test-audit*.md",
    "solutions/*",
    "solutions/**",
)
TEST_PARTS = {"test", "tests", "spec", "specs", "__tests__", "fixtures", "fixture"}
DOC_PARTS = {"doc", "docs", "documentation"}
TEST_SUFFIXES = ("_test.py", "_test.go", ".test.js", ".test.ts", ".spec.js", ".spec.ts")
DOC_SUFFIXES = (".md", ".rst", ".adoc", ".txt")
AGENT_WORDS = r"(?:agent|tool|ai|bot|mistral\s+vibe|vibe|claude|codex|copilot|chatgpt|openai|gemini|cursor)"
ATTRIBUTION_PATTERNS = (
    re.compile(rf"^Co-Authored-By:.*\b{AGENT_WORDS}\b", re.I | re.M),
    re.compile(r"^Generated by\b.*", re.I | re.M),
    re.compile(r"^Generated with\b.*", re.I | re.M),
    re.compile(r"^🤖.*(?:Claude|Vibe|Codex|AI|CE)", re.I | re.M),
    re.compile(r"\b(?:Claude|Vibe|Codex|CE)\s*(?:badge|generated|authored)\b", re.I),
)
NOOP_TEST_COMMANDS = {"true", "/usr/bin/true", "/bin/true", ":"}


def run_git(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], text=True, capture_output=True, check=check)


def git_out(*args: str) -> str:
    return run_git(*args).stdout.strip()


def resolve_base(base: str) -> str:
    try:
        git_out("rev-parse", "--verify", base)
        return base
    except subprocess.CalledProcessError:
        if base == "origin/main":
            git_out("rev-parse", "--verify", "main")
            return "main"
        raise


def commit_messages(base: str) -> list[tuple[str, str]]:
    raw = git_out("log", "--format=%H%x00%B%x00%x1e", f"{base}..HEAD")
    commits: list[tuple[str, str]] = []
    for record in raw.split("\x1e"):
        record = record.strip("\n\x00")
        if not record:
            continue
        sha, _, message = record.partition("\x00")
        commits.append((sha, message.strip()))
    return commits


def status(name: str, outcome: str, summary: str, **extra) -> dict:
    return {"name": name, "status": outcome, "summary": summary, **extra}


def check_attribution(base: str) -> dict:
    offenders = []
    for sha, message in commit_messages(base):
        for pattern in ATTRIBUTION_PATTERNS:
            match = pattern.search(message)
            if match:
                offenders.append({"commit": sha, "match": match.group(0).strip()})
                break
    if offenders:
        first = offenders[0]["match"]
        return status(
            "attribution",
            "fail",
            f"{len(offenders)} commit message(s) contain AI/tool attribution; first: {first}",
            offenders=offenders,
        )
    return status("attribution", "pass", "no AI/tool attribution in commit messages")


def is_test_path(path: str) -> bool:
    p = PurePosixPath(path)
    return any(part in TEST_PARTS for part in p.parts[:-1]) or p.name.endswith(TEST_SUFFIXES) or p.name.startswith("test_")


def is_doc_path(path: str) -> bool:
    p = PurePosixPath(path)
    return any(part in DOC_PARTS for part in p.parts[:-1]) or p.name.endswith(DOC_SUFFIXES)


def has_size_justification(base: str) -> bool:
    return any(re.search(r"^Size-justification:\s*\S", message, re.I | re.M) for _, message in commit_messages(base))


def numstat_split(base: str) -> dict:
    proc = run_git("diff", "--numstat", f"{base}...HEAD")
    split = {"production": 0, "tests": 0, "docs": 0, "files": []}
    for line in proc.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) < 3 or fields[0] == "-" or fields[1] == "-":
            continue
        added, deleted, path = int(fields[0]), int(fields[1]), fields[2]
        total = added + deleted
        kind = "tests" if is_test_path(path) else "docs" if is_doc_path(path) else "production"
        split[kind] += total
        split["files"].append({"path": path, "lines": total, "kind": kind})
    return split


def check_size(base: str) -> dict:
    split = numstat_split(base)
    justified = has_size_justification(base)
    production = split["production"]
    tests = split["tests"]
    if production > PRODUCTION_LIMIT and not justified:
        return status(
            "size",
            "fail",
            f"production lines {production} exceed {PRODUCTION_LIMIT} without Size-justification trailer; tests {tests}, docs {split['docs']}",
            split=split,
            size_justification=justified,
        )
    return status(
        "size",
        "pass",
        f"production lines {production}, tests {tests}, docs {split['docs']}"
        + ("; Size-justification present" if justified else ""),
        split=split,
        size_justification=justified,
    )


def matches_working_doc(path: str) -> bool:
    p = PurePosixPath(path)
    return any(p.match(pattern) for pattern in WORKING_DOC_PATTERNS)


def check_working_docs(base: str) -> dict:
    proc = run_git("diff", "--name-status", "--diff-filter=A", f"{base}...HEAD")
    bad = []
    for line in proc.stdout.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and matches_working_doc(fields[-1]):
            bad.append(fields[-1])
    if bad:
        return status("working_docs", "fail", f"working docs added on range: {', '.join(bad)}", paths=bad)
    return status("working_docs", "pass", "no working docs added on range", paths=[])


def parse_ship_check_toml(path: Path) -> str | None:
    if not path.exists():
        return None
    try:
        import tomllib  # Python 3.11+
    except ModuleNotFoundError:
        tomllib = None
    if tomllib is not None:
        data = tomllib.loads(path.read_text())
        value = data.get("test-cmd") or data.get("test_cmd")
        return value if isinstance(value, str) else None
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, value = [part.strip() for part in line.split("=", 1)]
        if key in {"test-cmd", "test_cmd"}:
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                return value[1:-1]
            return value
    return None


def test_command(args: argparse.Namespace) -> str | None:
    if args.test_cmd:
        return args.test_cmd
    return parse_ship_check_toml(Path("ship-check.toml"))


def is_noop_command(command: str) -> bool:
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    if not words:
        return True
    return len(words) == 1 and words[0] in NOOP_TEST_COMMANDS


def check_tests(args: argparse.Namespace) -> dict:
    command = test_command(args)
    if not command:
        return status("tests", "skipped", "no test command configured; pass --test-cmd or add ship-check.toml", command=None)
    if is_noop_command(command):
        return status("tests", "fail", f"test command {command!r} is a no-op bypass", command=command, exit_code=None)
    proc = subprocess.run(command, shell=True, text=True, capture_output=True)
    if proc.returncode != 0:
        return status(
            "tests",
            "fail",
            f"test command exited with exit code {proc.returncode}: {command}",
            command=command,
            exit_code=proc.returncode,
            stdout_tail="\n".join(proc.stdout.splitlines()[-40:]),
            stderr_tail="\n".join(proc.stderr.splitlines()[-40:]),
        )
    return status("tests", "pass", f"test command passed: {command}", command=command, exit_code=0)


def check_mutation(args: argparse.Namespace, base: str) -> dict:
    if not args.mutate:
        return status("mutation", "skipped", "--mutate not requested")
    script = Path(__file__).resolve().parents[1] / "local-skills" / "rebuilding-final-tests" / "scripts" / "mutation_compare.py"
    with tempfile.TemporaryDirectory(prefix="ship-check-mutate-") as tmp:
        out = Path(tmp) / "baseline.json"
        proc = subprocess.run([sys.executable, str(script), "baseline", "--base", base, "--out", str(out)], text=True, capture_output=True)
        payload = json.loads(out.read_text()) if out.exists() else None
    if proc.returncode != 0:
        return status(
            "mutation",
            "fail",
            f"mutation_compare exited {proc.returncode}",
            exit_code=proc.returncode,
            stdout_tail="\n".join(proc.stdout.splitlines()[-40:]),
            stderr_tail="\n".join(proc.stderr.splitlines()[-40:]),
            report=payload,
        )
    return status("mutation", "pass", "mutation_compare passed", exit_code=0, report=payload)


def repo_id() -> str:
    root = Path(git_out("rev-parse", "--show-toplevel")).resolve()
    digest = hashlib.sha256(str(root).encode()).hexdigest()[:16]
    return f"{root.name}-{digest}"


def receipt_path(home: Path, repo: str, sha: str) -> Path:
    return home / ".local" / "state" / "ship-check" / repo / f"{sha}.json"


def write_receipt(data: dict) -> Path:
    path = receipt_path(Path.home(), data["repo_id"], data["sha"])
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)
    return path


def print_check(result: dict) -> None:
    print(f"{result['name']}: {result['status'].upper()} - {result['summary']}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--test-cmd")
    parser.add_argument("--mutate", action="store_true")
    args = parser.parse_args(argv)

    try:
        base = resolve_base(args.base)
        sha = git_out("rev-parse", "HEAD")
        tree_hash = git_out("rev-parse", "HEAD^{tree}")
        checks = [
            check_attribution(base),
            check_size(base),
            check_working_docs(base),
            check_tests(args),
            check_mutation(args, base),
        ]
    except (subprocess.CalledProcessError, OSError, json.JSONDecodeError) as error:
        print(f"ship-check: {error}", file=sys.stderr)
        return 2

    for result in checks:
        print_check(result)
    failures = [c for c in checks if c["status"] == "fail"]
    data = {
        "tool_version": VERSION,
        "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
        "repo_id": repo_id(),
        "repo_root": str(Path(git_out("rev-parse", "--show-toplevel")).resolve()),
        "sha": sha,
        "tree_hash": tree_hash,
        "base": base,
        "checks": {c["name"]: c for c in checks},
        "overall": "fail" if failures else "pass",
    }
    path = write_receipt(data)
    print(f"receipt: {path}")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
