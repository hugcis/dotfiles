#!/usr/bin/env python3

import argparse
import errno
import hashlib
import os
import re
import secrets
import subprocess
from pathlib import Path, PurePosixPath
from urllib.parse import urlsplit, urlunsplit


MARKER_NAME = ".ce-repository-identity"


def run_git(cwd: Path, *args: str) -> str | None:
    result = subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def _normalize_remote(remote: str) -> str:
    value = remote.strip()
    if "://" in value:
        parsed = urlsplit(value)
        hostname = parsed.hostname or ""
        if ":" in hostname:
            hostname = f"[{hostname}]"
        netloc = hostname
        if parsed.port is not None:
            netloc = f"{netloc}:{parsed.port}"
        path = parsed.path.rstrip("/")
        if path.endswith(".git"):
            path = path[:-4]
        return urlunsplit((parsed.scheme.lower(), netloc, path, "", ""))

    value = value.rstrip("/")
    if value.endswith(".git"):
        value = value[:-4]
    scp_remote = re.fullmatch(r"(?:[^@/]+@)?([^:/]+):(.+)", value)
    if scp_remote:
        return f"{scp_remote.group(1)}:{scp_remote.group(2)}"
    return value


def _remote_basename(identity: str) -> str:
    if "://" in identity:
        path = urlsplit(identity).path
    elif re.fullmatch(r"[^:/]+:.+", identity):
        path = identity.split(":", 1)[1]
    else:
        path = identity
    return PurePosixPath(path).name


def canonical_identity(cwd: Path) -> tuple[str, str] | None:
    top_level = run_git(cwd, "rev-parse", "--show-toplevel")
    if top_level is None:
        return None
    common_dir = run_git(
        cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"
    )
    if common_dir is None:
        return None

    remote = run_git(cwd, "config", "--get", "remote.origin.url")
    if remote:
        identity = _normalize_remote(remote)
        return identity, sanitize_name(_remote_basename(identity))

    common_path = Path(common_dir).resolve()
    return str(common_path), sanitize_name(_common_base_name(common_path, top_level))


def _common_base_name(common_path: Path, top_level: str) -> str:
    """Derive a base name that every checkout sharing a common Git directory agrees on.

    The current checkout basename cannot be used: linked worktrees and
    ``--separate-git-dir`` layouts would each claim a different artifact root.
    """
    if common_path.name == ".git":
        return common_path.parent.name
    name = common_path.name
    if name.endswith(".git") and name != ".git":
        name = name[: -len(".git")]
    return name or Path(top_level).resolve().name


def sanitize_name(value: str) -> str:
    sanitized = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip(".-")
    return sanitized or "repository"


def _open_directory(directory: Path) -> int | None:
    """Open ``directory`` itself, never a symlink standing in for it."""
    try:
        return os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR):
            raise RuntimeError(f"refusing symlinked artifact directory {directory}")
        raise


def _read_marker(directory: Path, dir_fd: int) -> str | None:
    try:
        descriptor = os.open(MARKER_NAME, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.ENOTDIR):
            raise RuntimeError(f"refusing symlinked identity marker in {directory}")
        raise
    with os.fdopen(descriptor, "r") as stream:
        return stream.read()


def _marker_matches(directory: Path, identity: str) -> bool | None:
    dir_fd = _open_directory(directory)
    if dir_fd is None:
        return None
    try:
        content = _read_marker(directory, dir_fd)
    finally:
        os.close(dir_fd)
    if content is None:
        return None
    return content == f"{identity}\n"


def _make_directory(docs_home: Path, directory: Path) -> None:
    docs_home.mkdir(parents=True, exist_ok=True)
    try:
        os.mkdir(directory, 0o755)
    except FileExistsError:
        pass


def _claim_directory(docs_home: Path, directory: Path, identity: str) -> bool:
    _make_directory(docs_home, directory)
    dir_fd = _open_directory(directory)
    if dir_fd is None:
        raise RuntimeError(f"artifact directory disappeared: {directory}")
    temporary_name = (
        f"{MARKER_NAME}.tmp-{os.getpid()}-{secrets.token_hex(8)}"
    )
    descriptor = None
    try:
        descriptor = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o644,
            dir_fd=dir_fd,
        )
        stream = os.fdopen(descriptor, "w")
        descriptor = None
        with stream:
            stream.write(f"{identity}\n")
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.link(
                temporary_name,
                MARKER_NAME,
                src_dir_fd=dir_fd,
                dst_dir_fd=dir_fd,
                follow_symlinks=False,
            )
        except FileExistsError:
            return _read_marker(directory, dir_fd) == f"{identity}\n"
        return True
    finally:
        if descriptor is not None:
            os.close(descriptor)
        try:
            os.unlink(temporary_name, dir_fd=dir_fd)
        except FileNotFoundError:
            pass
        os.close(dir_fd)


def _validated_child(docs_home: Path, name: str) -> Path:
    if not name or name in (".", "..") or "/" in name:
        raise RuntimeError(f"refusing artifact directory name {name!r}")
    candidate = docs_home / name
    if candidate.is_symlink():
        raise RuntimeError(f"refusing symlinked artifact directory {candidate}")
    if candidate.resolve() != candidate:
        raise RuntimeError(f"refusing artifact path outside {docs_home}")
    return candidate


def resolve_artifact_root(cwd: Path, docs_home: Path, create: bool) -> Path:
    docs_home = docs_home.expanduser().resolve()
    repository = canonical_identity(cwd)
    if repository is None:
        result = _validated_child(docs_home, "general")
        if create:
            _make_directory(docs_home, result)
            dir_fd = _open_directory(result)
            if dir_fd is not None:
                os.close(dir_fd)
    else:
        identity, name = repository
        result = _validated_child(docs_home, name)
        marker_matches = _marker_matches(result, identity)
        if marker_matches is False:
            suffix = hashlib.sha256(identity.encode()).hexdigest()[:8]
            result = _validated_child(docs_home, f"{name}-{suffix}")
            marker_matches = _marker_matches(result, identity)
            if marker_matches is False:
                raise RuntimeError(f"artifact identity collision at {result}")
        if (
            create
            and marker_matches is not True
            and not _claim_directory(docs_home, result, identity)
        ):
            if result.name == name:
                suffix = hashlib.sha256(identity.encode()).hexdigest()[:8]
                result = _validated_child(docs_home, f"{name}-{suffix}")
                if not _claim_directory(docs_home, result, identity):
                    raise RuntimeError(f"artifact identity collision at {result}")
            else:
                raise RuntimeError(f"artifact identity collision at {result}")

    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--cwd", type=Path, default=Path.cwd())
    parser.add_argument("--no-create", action="store_true")
    args = parser.parse_args()
    result = resolve_artifact_root(
        args.cwd.resolve(), Path.home() / "docs", not args.no_create
    )
    print(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
