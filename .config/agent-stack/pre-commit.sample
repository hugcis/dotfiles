#!/usr/bin/env bash
# Blocks work-sensitive strings and credential shapes from the PUBLIC dotfiles repo.
set -uo pipefail

# Patterns live in an UNTRACKED file, never in this script.
#
# A denylist names the things that must not be published, so committing the list
# publishes them. This script is versioned as pre-commit.sample; the patterns it
# reads are not. See denylist.example.txt for the format.
DENYLIST="$HOME/.config/agent-stack/denylist.txt"
if [ ! -f "$DENYLIST" ]; then
  echo "pre-commit: no denylist at $DENYLIST; refusing to run unguarded." >&2
  echo "Copy denylist.example.txt to denylist.txt and fill in this machine's terms." >&2
  exit 1
fi

if ! pattern_text="$(grep -vE '^[[:space:]]*(#|$)' "$DENYLIST" 2>/dev/null)"; then
  echo "pre-commit: denylist is empty or unreadable; refusing to run unguarded." >&2
  exit 1
fi

if ! staged="$(git diff --cached --no-ext-diff --no-textconv --no-color -U0 2>/dev/null)"; then
  echo "pre-commit: cannot read the staged diff; refusing to run unguarded." >&2
  exit 1
fi

fail=0
index=0
# A pipe would put the loop in a subshell and lose its failure status.
while IFS= read -r pattern; do
  index=$((index + 1))
  status=0
  grep -E -- "^\+.*${pattern}" <<< "$staged" >/dev/null 2>&1 || status=$?
  case "$status" in
    0)
      echo "BLOCKED: staged content matches denylist rule $index; inspect it locally." >&2
      fail=1
      ;;
    1) ;;
    *)
      echo "pre-commit: scan failed for denylist rule $index; refusing to run unguarded." >&2
      exit 1
      ;;
  esac
done <<< "$pattern_text"

if [ "$fail" -ne 0 ]; then
  echo "This repo is public. Keep sensitive values in untracked machine configuration." >&2
  exit 1
fi
exit 0
