#!/usr/bin/env bash
# agent-stack-render [STACK_DIR] — render agent-stack for this machine.
#
# Runs on every hm switch (modules/agent-stack.nix), so it skips machines
# without an agent-stack profile and reports render problems as warnings
# instead of failing the switch. STACK_DIR defaults to ~/.config/agent-stack.
set -uo pipefail

stack="${1:-$HOME/.config/agent-stack}"
if [[ ! -f "$stack/profile.yaml" ]]; then
  echo "agent-stack: no profile.yaml in $stack; skipping render"
  exit 0
fi

if ! out="$(python3 "$stack/render.py" validate --profile "$stack/profile.yaml" 2>&1)"; then
  echo "agent-stack: WARNING: validation failed; agents were not re-rendered:" >&2
  printf '%s\n' "$out" >&2
  exit 0
fi

if ! out="$(python3 "$stack/render.py" 2>&1)"; then
  echo "agent-stack: WARNING: render failed:" >&2
  printf '%s\n' "$out" >&2
  exit 0
fi
printf '%s\n' "$out"
