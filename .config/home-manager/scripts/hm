#!/usr/bin/env bash
# hm — switch home-manager for this machine.
#
# Host resolution order:
#   1. explicit known host argument:  hm rpi-5
#   2. ~/.config/home-manager/host (one-line marker file, not in git —
#      create it wherever the hostname/uname guess is wrong)
#   3. hostname match (this box's short hostname equals a registry key)
#   4. darwin -> mac (macOS hostnames rarely match the registry key)
#
# Any other first argument (or none) passes through to home-manager:
#   hm news            runs `home-manager news`
#   hm archcis build
#
# If ~/.config/home-manager/private-flake exists (one-line marker, not in
# git), it names a private flake to switch from instead. See below.
set -euo pipefail

flake_dir="$HOME/.config/home-manager"
user="$(id -un)"
known_hosts="mac mistral-mac archcis rpi-5 remote-mistral"

host=""
rest=("$@")
if [[ $# -ge 1 && " $known_hosts " == *" $1 "* ]]; then
  host="$1"
  rest=("${@:2}")
fi

if [[ -z "$host" && -r "$flake_dir/host" ]]; then
  host="$(head -n1 "$flake_dir/host")"
  if [[ " $known_hosts " != *" $host "* ]]; then
    echo "hm: $flake_dir/host contains unknown host '$host' (known: $known_hosts)" >&2
    exit 1
  fi
fi

if [[ -z "$host" ]]; then
  hn="$(hostname -s 2>/dev/null || true)"
  if [[ " $known_hosts " == *" $hn "* ]]; then
    host="$hn"
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    host="mac"
  else
    echo "hm: cannot guess a host for '$hn' ($(uname -sm)); pass one of: $known_hosts" >&2
    exit 1
  fi
fi

# Optional private flake layered on this one, for machine-specific config
# that must stay out of this public repo. It takes this flake as its
# `dotfiles` input and exports the same homeConfigurations name. The input
# is pointed at this working copy, so uncommitted edits apply and the
# private lock file is not rewritten on every switch.
private_marker="$flake_dir/private-flake"
if [[ -r "$private_marker" ]]; then
  private_flake="$(head -n1 "$private_marker")"
  if [[ ! -f "$private_flake/flake.nix" ]]; then
    echo "hm: $private_marker points at '$private_flake', which has no flake.nix" >&2
    exit 1
  fi
  exec home-manager switch --flake "$private_flake#$user@$host" \
    --override-input dotfiles "path:$flake_dir" --no-write-lock-file \
    ${rest[@]+"${rest[@]}"}
fi

exec home-manager switch --flake "$flake_dir#$user@$host" ${rest[@]+"${rest[@]}"}
